# PostgreSQL do Supabase (Transaction pooler; usuário granize_backend)
DATABASE_URL=
# Opcional: certificado raiz do banco em PEM, sem desativar a verificação TLS.
DATABASE_CA_CERT=

# Fotos privadas; chave somente no servidor, nunca com prefixo NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Login com Google (OAuth 2.0 para aplicativo Web)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Desenvolvimento local: http://localhost:3000/api/auth/google/callback
GOOGLE_REDIRECT_URI=

# Evolution API v2
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_WEBHOOK_SECRET=
# Endereço que a Evolution, dentro do Docker, usa para chamar o Granize local
EVOLUTION_WEBHOOK_BASE_URL=
GRANIZE_BOT_INSTANCE_NAME=granize-bot

# n8n recebe os eventos do WhatsApp e devolve lançamentos processados
N8N_WEBHOOK_URL=
WHISPER_API_URL=
WHISPER_MODEL=Systran/faster-whisper-small
N8N_SHARED_SECRET=

# Stripe Checkout (use chaves de teste antes da produção)
# Endereço público da Granize. Obrigatório em produção; HTTPS para cobranças reais.
APP_URL=http://localhost:3000
# test por padrão; live somente após validar o fluxo completo.
STRIPE_MODE=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
